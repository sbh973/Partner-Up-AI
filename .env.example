# ─────────────────────────────────────────────────────────────
# Partner Up AI — environment variables
# Copy to `.env` and fill in. NOTHING here is exposed to the browser:
# the React app gets public config from GET /api/config at runtime.
# ─────────────────────────────────────────────────────────────

# AI provider (optional). Without a key, Partner AI uses its built-in
# deterministic language understanding so the demo still works offline.
ANTHROPIC_API_KEY=
# Model used for intent parsing / Partner DNA / explanations.
ANTHROPIC_MODEL=claude-opus-5
# Max time (ms) to wait for the model before falling back to the local parser.
AI_TIMEOUT_MS=9000

# Supabase (optional). If SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are unset,
# the app runs in "demo" data mode with a seeded in-memory store.
SUPABASE_URL=
# Public anon key — served to the browser via /api/config for Supabase Auth.
SUPABASE_ANON_KEY=
# Server-only. Never prefix with VITE_ and never ship to the client.
SUPABASE_SERVICE_ROLE_KEY=

# One-click demo account (used by "Try the demo" in Supabase mode;
# created by `npm run seed:supabase`). Server-only.
DEMO_EMAIL=demo@partnerup.test
DEMO_PASSWORD=

# Port for `npm start` (production server).
PORT=8787
