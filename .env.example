# ─────────────────────────────────────────────────────────────
# Partner Up — AI powered by Muse · environment variables
#
# Copy this file to `.env.local` and fill in real values there.
# `.env` and `.env.local` are gitignored — NEVER commit a real key.
# In production, set these in your host's secret manager
# (e.g. Vercel → Project → Settings → Environment Variables).
#
# Everything here is server-side only. No variable is prefixed with
# VITE_, so none of it can ever be bundled into browser code.
# ─────────────────────────────────────────────────────────────

# ── Muse (Meta) — used by Scout only. Mutual never calls AI. ──
# `muse` = use Muse when a key is present; `offline` = always use the
# built-in deterministic fallback (no network calls).
AI_PROVIDER=muse
MUSE_API_KEY=
MUSE_MODEL=muse-spark-1.1
MUSE_BASE_URL=https://api.meta.ai/v1
# minimal | low | medium | high — lower is faster for a live demo.
MUSE_REASONING_EFFORT=minimal
# Every Muse call falls back to offline matching after this many ms.
MUSE_TIMEOUT_MS=5000

# ── Database (SQLite via Prisma; path is relative to prisma/) ──
DATABASE_URL="file:./dev.db"

# ── Sessions ── required in production. Use a long random string,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=

# ── Demo ── seeds fictional people + one-click demo accounts.
# Set to `false` for a real deployment.
DEMO_MODE=true

# ── Mutual rules ──
MUTUAL_REQUEST_LIMIT=5
MUTUAL_WINDOW_DAYS=30
MUTUAL_REQUEST_TTL_DAYS=30
MUTUAL_END_AFTER_HOURS=24
MIN_AGE=18

# ── Production server (`npm start`) ──
PORT=8787
