{
  "name": "partner-up-ai",
  "version": "0.1.0",
  "description": "Partner Up — AI powered by Muse. Mutual: you know who. Scout: you know what.",
  "scripts": {
    "dev": "node scripts/db-push.mjs && vite",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "esbuild server/prod.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs",
    "start": "node scripts/db-push.mjs && node dist-server/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:push": "node scripts/db-push.mjs",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
